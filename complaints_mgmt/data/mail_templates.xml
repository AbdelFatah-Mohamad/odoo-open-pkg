<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Optional: Mail Template for New Complaint Notification to Admins -->
        <record id="mail_complaint_new_to_admin" model="mail.template">
            <field name="name">Complaint: New Complaint Notification</field>
            <field name="model_id" ref="model_complaints_complaint"/>
            <field name="subject">New Complaint Received: ${object.name}</field>
            <field name="email_from">${object.company_id.email or ''}</field>
            <field name="email_to">${','.join([p.email for p in object._admin_partners() if p.email])}</field>
            <field name="body_html" type="html">
                <div style="font-family: 'Lucida Grande', Ubuntu, Arial, Verdana, sans-serif; font-size: 12px; color: rgb(34, 34, 34); background-color: #FFF; ">
                    <p>Hello,</p>
                    <p>A new complaint has been submitted:</p>
                    <ul>
                        <li><strong>Reference:</strong> ${object.name}</li>
                        <li><strong>Complainant:</strong> ${object.partner_id.name}</li>
                        <li><strong>Target Company:</strong> ${object.company_target_id.name}</li>
                        <li><strong>Amount Requested:</strong> ${object.amount_requested} ${object.currency_id.name}</li>
                        <li><strong>Status:</strong> ${object.state}</li>
                    </ul>
                    <p>Please review this complaint at your earliest convenience.</p>
                    <p style="text-align: center; margin-top: 20px;">
                        <a href="/web#id=${object.id}&amp;model=complaints.complaint&amp;view_type=form"
                           style="padding: 10px; background-color: #875A7B; color: #fff; text-decoration: none; border-radius: 5px;">
                            View Complaint
                        </a>
                    </p>
                    <p>Thank you,<br/>Complaints Management System</p>
                </div>
            </field>
        </record>
    </data>
</odoo>
