<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Action: Open Complaints -->
        <record id="action_complaints" model="ir.actions.act_window">
            <field name="name">Complaints</field>
            <field name="res_model">complaints.complaint</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first complaint
                </p>
                <p>
                    Submit a complaint against a company. Track the complete workflow from submission through approval to payment.
                </p>
            </field>
        </record>

        <!-- Root Menu -->
        <menuitem
            id="menu_complaints_root"
            name="Complaints"
            sequence="50"
            groups="group_complaint_user,group_complaint_company,group_complaint_admin"
            web_icon="complaints_mgmt,static/description/icon.png"/>

        <!-- Sub Menu -->
        <menuitem
            id="menu_complaints"
            name="All Complaints"
            parent="menu_complaints_root"
            action="action_complaints"
            sequence="10"/>
    </data>
</odoo>
