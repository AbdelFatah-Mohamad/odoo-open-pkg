<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View account.check.cancel.reason form -->
    <record id="view_account_check_cancel_reason_form" model="ir.ui.view">
        <field name="name">view.account.check.cancel.reason.form</field>
        <field name="model">account.check.cancel.reason</field>
        <field name="arch" type="xml">
            <form string="Account Check Cancel Reason">
                <div class="oe_title">
                    <label for="name"/>
                    <h1>
                        <field name="name" placeholder="Name..."/>
                    </h1>
                </div>
                <footer>
                    <button name="add" type="object" string="Add" class="oe_highlight"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action account.check.cancel.reason -->
    <record id="action_account_check_cancel_reason" model="ir.actions.act_window">
        <field name="name">Account Check Cancel Reason</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">account.check.cancel.reason</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
