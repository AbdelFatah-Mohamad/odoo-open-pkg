<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="account_check_view_form" model="ir.ui.view">
        <field name="name">account_check.view.form</field>
        <field name="model">account.check</field>
        <field name="arch" type="xml">
            <form create="0">
                <header>
                    <button name="%(invoice_res_bank_print_action)d" type="action" invisible="state not in ('cashed', 'endorsed','deposited')" string="Print Cheque" icon="fa-money" widget="statinfo" groups="account.group_account_manager"/>
                    <button string="Checkbox Transfer" name="%(action_account_check_bank_transfer_checkbox)d" type="action" invisible="state != 'returned'" />
                    <button string="Bank Transfer" name="%(action_account_check_bank_transfer_bank)d" type="action" invisible="state != 'collected'" />
                    <button string="Return Check" name="odoo_check_managment.action_account_check_return_check" type="action" invisible="state != 'cashed'" />
                    <button string="Return To Return Checkbox Journal Account" name="move_check_to_return_journal_account" type="object" invisible="state != 'returned_to_partner'" />
                    <field name="state" widget="statusbar" statusbar_visible="check_book,collected,deposited,cashed,returned,endorsed" />
                </header>
                <sheet>
                    <field name="image" widget="image" class="oe_avatar" />
                    <div class="oe_title">
                        <h1>
                            <field name="name" nolabel="1" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="check_no" readonly="payment_state == 'posted'" />
                            <field name="due_date" required="1" readonly="payment_state == 'posted'" />
                            <field name="currency_id" invisible="1" readonly="payment_state == 'posted' or state  != 'collected'" />
                            <field name="journal_id" readonly="1"/>
                            <field name="amount" widget='monetary' readonly="payment_state == 'posted' or state  != 'collected'" />
                            <field name="check_book_id" widget="many2one" readonly="1" invisible="not check_book_id" />
                            <field name="bank_id" widget="many2one" readonly="payment_state == 'posted' or state  != 'collected'" />
                            <field name="third_party" readonly="payment_state == 'posted'" />
                            <field name="third_party_name" invisible="third_party == False" readonly="payment_state == 'posted' or state  != 'collected'" />
                        </group>
                        <group>
                            <field name="payment_id" readonly="1" widget="many2one" />
                            <field name="payment_state" />
                            <field name="payment_type" />
                            <field name="partner_id" widget="many2one" />
                            <!-- <field name="is_internal_transfer" /> -->
                            <field name="payment_date" />
                            <field name="check_tag_ids" widget="many2many_tags" options="{'color': 'color', 'sequence': 'sequence'}" />
                        </group>
                    </group>
                    <notebook>
                        <page name="operations" string="Operations">
                            <field name="operation_ids">
                                <list>
                                    <field name="action_date" />
                                    <field name="user_id" widget="many2one" />
                                    <field name="state" />
                                    <field name="operation_type" />
                                    <field name="partner_id" widget="many2one" />
                                    <field name="journal_id" widget="many2one" />
                                    <field name="payment_id" widget="many2one" />
                                    <field name="payment_state" />
                                    <field name="move_id" widget="many2one" />
                                    <field name="destination_journal_id" widget="many2one" />
                                    <!-- <field name="note"/> -->
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="account_check_view_tree" model="ir.ui.view">
        <field name="name">account_check.view.list</field>
        <field name="model">account.check</field>
        <field name="arch" type="xml">
            <list create="0">
                <field name="name" />
                <field name="check_no" optional="show" />
                <field name="state" optional="show" />
                <field name="due_date" required="1" optional="show" />
                <field name="currency_id" optional="show" />
                <field name="amount" widget='monetary' sum="Total" options="{'currency_field': 'currency_id'}" optional="show" />
                <field name="journal_id" widget="many2one" optional="show" />
                <field name="bank_id" widget="many2one" optional="show" />
                <field name="payment_id" widget="many2one" optional="show" />
                <field name="payment_type" optional="show" />
                <field name="partner_id" widget="many2one" optional="show" />
                <field name="check_tag_ids" widget="many2many_tags" options="{'color': 'color'}" optional="show" />
                <!-- <field name="is_internal_transfer" optional="show" /> -->
                <field name="payment_date" optional="show" />
            </list>
        </field>
    </record>

    <record id="account_check_view_search" model="ir.ui.view">
        <field name="name">account.check.view.search</field>
        <field name="model">account.check</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Name" filter_domain="[('name','ilike',self)]" />
                <field name="check_no" string="Check NO." filter_domain="[('check_no','ilike',self)]" />
                <group expand="0" string="Group By">
                    <filter string="Partner" name="groupy_by_partner" domain="[]" context="{'group_by': 'partner_id'}" />
                    <filter string="Status" name="status" context="{'group_by':'state'}" />
                    <filter string="Journal" name="groupy_by_journal" domain="[]" context="{'group_by': 'journal_id'}" />
                    <separator />
                    <filter string="Due Date" name="invoicedate" context="{'group_by': 'due_date'}" />
                    <filter string="Currency" name="group_currency_id" context="{'group_by': 'currency_id'}" />
                    <filter string="Bank" name="group_by_bank_id" context="{'group_by': 'bank_id'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="account_check_in_action" model="ir.actions.act_window">
        <field name="name">Checks</field>
        <field name="res_model">account.check</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('check_type','=','in')]</field>
    </record>
    <record id="account_check_out_action" model="ir.actions.act_window">
        <field name="name">Checks</field>
        <field name="res_model">account.check</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('check_type','=','out')]</field>
    </record>

    <!-- <record id="return_check_action_server" model="ir.actions.server">
        <field name="name">Return Cashed Check</field>
