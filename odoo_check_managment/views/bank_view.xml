<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_bank_form" model="ir.ui.view">
        <field name="name">res.bank.form</field>
        <field name="model">res.bank</field>
        <field name="arch" type="xml">
            <form string="Bank">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group name="bank_details" col="4">
                        <field name="name"/>
                        <field name="bic"/>
                    </group>
                    <group>
                        <group name="address_details">
                            <label for="street" string="Bank Address"/>
                            <div class="o_address_format">
                                <field name="street" placeholder="Street..." class="o_address_street"/>
                                <field name="street2" placeholder="Street 2..." class="o_address_street"/>
                                <field name="city" placeholder="City" class="o_address_city"/>
                                <field name="state" class="o_address_state" placeholder="State" options='{"no_open": True}'/>
                                <field name="zip" placeholder="ZIP" class="o_address_zip"/>
                                <field name="country" placeholder="Country" class="o_address_country" options='{"no_open": True, "no_create": True}'/>
                            </div>
                        </group>
                        <group name="communication_details">
                            <field name="phone" class="o_force_ltr"/>
                            <field name="email" widget="email"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <group>
                        <group name="res_bank" string="Bank Check">
                            <field name="check_measure_unit"/>
                            <field name="check_height"/>
                            <field name="check_width"/>
                            <field name="max_char_in_line1"/>
                        </group>
                        <group>
                            <label for="main_check_image" style="font-weight: bold;"/>
                            <field name="main_check_image" widget='image' nolabel="1"/>
                            <field name="check_image"/>
                        </group>
                        <label for="check_attribute_line_ids" style="font-weight: bold;"/>
                        <button name="redirect_to_res_bank_page" type="object" string="Configure Attributes" style="float:right" icon="fa-cog fa-spin" class="oe_highlight"/>
                        <br/>
                    </group>
                    <field name="check_attribute_line_ids">
                        <list editable="bottom">
                            <field name="name"/>
                            <field name="font_size"/>
                            <field name="letter_spacing"/>
                            <field name="top_displacement"/>
                            <field name="left_displacement"/>
                            <field name="height"/>
                            <field name="width"/>
                            <button name="reset_values" string="Reset" class="fa fa-undo" type="object"/>
                        </list>
                        <form>
                            <group>
                                <field name="name"/>
                            </group>
                            <group col="4" string="CSS Attributes">
                                <field name="font_size"/>
                                <field name="letter_spacing"/>
                                <field name="top_displacement"/>
                                <field name="left_displacement"/>
                                <field name="bottom_displacement"/>
                                <field name="right_displacement"/>
                                <field name="height"/>
                                <field name="width"/>
                            </group>
                            <button name="reset_values" string="Reset" icon="fa-undo" class="oe_highlight" type="object" title="Reset Values"/>
                        </form>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_res_bank_tree" model="ir.ui.view">
        <field name="name">res.bank.list</field>
        <field name="model">res.bank</field>
        <field name="arch" type="xml">
            <list string="Banks">
                <field name="name"/>
                <field name="bic"/>
                <field name="country"/>
            </list>
        </field>
    </record>

    <record id="res_bank_view_search" model="ir.ui.view">
        <field name="name">res.bank.view.search</field>
        <field name="model">res.bank</field>
        <field name="arch" type="xml">
            <search string="Search Bank">
                <field name="name"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="res_bank_action" model="ir.actions.act_window">
        <field name="name">Banks</field>
        <field name="res_model">res.bank</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="res_bank_view_search"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('odoo_check_managment.view_res_bank_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('odoo_check_managment.view_res_bank_form')})]"/>
    </record>

    <record id="res_bank_attribute_view_form" model="ir.ui.view">
        <field name="name">res.bank.attribute.form.view</field>
        <field name="model">res.bank.attribute</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="attribute"/>
                            <field name="date_format" invisible="attribute != 'check_date'" required="attribute == 'check_date'" />
                        </group>
                        <group>
                            <field name="demo_data" invisible="attribute == 'check_date'"/>
                            <field name="demo_data_date" invisible="attribute == 'check_date'"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="res_bank_attribute_view_tree" model="ir.ui.view">
        <field name="name">res.bank.attribute.view.list</field>
        <field name="model">res.bank.attribute</field>
        <field name="arch" type="xml">
            <list string="Bank Check Attributes">
                <field name="name"/>
                <field name="attribute"/>
            </list>
        </field>
    </record>

    <record id="res_bank_attribute_action" model="ir.actions.act_window">
        <field name="name">Bank Check Attributes</field>
        <field name="res_model">res.bank.attribute</field>
        <field name="view_mode">list,form</field>
    </record>


</odoo>
