<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data noupdate="1">
        <record id="seq_check_management" model="ir.sequence">
            <field name="name">Check Management</field>
            <field name="code">account.check</field>
            <field name="prefix">CHECK/%(year)s/%(month)s/%(day)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_check_book_management" model="ir.sequence">
            <field name="name">Check Book Management</field>
            <field name="code">account.check.book</field>
            <field name="prefix">CHECKBOOK/%(year)s/%(month)s/%(day)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>

</odoo>
