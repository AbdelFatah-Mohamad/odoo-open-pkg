{"name":"Odoo","settings":"{\"settings\":\"{\\n    \\\"workbench.iconTheme\\\": \\\"material-icon-theme\\\",\\n    \\\"[xml]\\\": {\\n        \\\"editor.defaultFormatter\\\": \\\"redhat.vscode-xml\\\"\\n    },\\n    \\\"github.copilot.enable\\\": {\\n        \\\"*\\\": true,\\n        \\\"plaintext\\\": true,\\n        \\\"markdown\\\": true,\\n        \\\"scminput\\\": false\\n    },\\n    \\\"editor.fontSize\\\": 24,\\n    \\\"xmlTools.splitXmlnsOnFormat\\\": false,\\n    \\\"xml.format.preserveAttributeLineBreaks\\\": false,\\n    \\\"git.confirmSync\\\": false,\\n    \\\"window.zoomLevel\\\": -1,\\n    \\\"python.analysis.extraPaths\\\": [\\n        \\\"./odoo\\\",\\n        \\\"./enterprise\\\",\\n        \\\"./custom_addons\\\",\\n        \\\"./projects\\\"\\n    ],\\n    \\\"redhat.telemetry.enabled\\\": true,\\n    \\\"[javascript]\\\": {\\n        \\\"editor.defaultFormatter\\\": \\\"vscode.typescript-language-features\\\"\\n    },\\n    \\\"[python]\\\": {\\n        \\\"editor.defaultFormatter\\\": \\\"ms-python.autopep8\\\",\\n        \\\"diffEditor.ignoreTrimWhitespace\\\": false\\n    },\\n    \\\"files.autoSave\\\": \\\"afterDelay\\\",\\n    \\\"xml.codeLens.enabled\\\": true,\\n    \\\"xml.completion.autoCloseRemovesContent\\\": false,\\n    \\\"[jsonc]\\\": {\\n        \\\"editor.defaultFormatter\\\": \\\"vscode.json-language-features\\\"\\n    },\\n    \\\"git.enableSmartCommit\\\": true,\\n    \\\"chatgpt.timeoutLength\\\": 10,\\n    \\\"chatgpt.apiKey\\\": \\\"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\\\",\\n    \\\"git.ignoreRebaseWarning\\\": true,\\n    \\\"[html]\\\": {\\n        \\\"editor.defaultFormatter\\\": \\\"esbenp.prettier-vscode\\\"\\n    },\\n    \\\"[json]\\\": {\\n        \\\"editor.defaultFormatter\\\": \\\"vscode.json-language-features\\\"\\n    },\\n    \\\"gitlens.gitCommands.skipConfirmations\\\": [\\n        \\\"fetch:command\\\"\\n    ],\\n    \\\"git.autofetch\\\": true,\\n    \\\"editor.stickyScroll.enabled\\\":