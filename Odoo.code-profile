         \\\"matchCommandLine\\\": true\\n        },\\n        \\\"mv\\\": true,\\n        \\\"/^python3 << 'EOF'\\\\nimport re\\\\n\\\\nwith open\\\\\\\\('/opt/odoo16/projects/studio_customization/data/ir_model_fields\\\\\\\\.xml', 'r'\\\\\\\\) as f:\\\\n    content = f\\\\\\\\.read\\\\\\\\(\\\\\\\\)\\\\n\\\\n# Find all records\\\\nrecords = re\\\\\\\\.findall\\\\\\\\(r'<record\\\\\\\\[\\\\\\\\^>\\\\\\\\]\\\\\\\\*>\\\\\\\\.\\\\\\\\*\\\\\\\\?</record>', content, re\\\\\\\\.DOTALL\\\\\\\\)\\\\n\\\\nsale_order_fields = \\\\\\\\[\\\\\\\\]\\\\naccount_move_fields = \\\\\\\\[\\\\\\\\]\\\\naccount_payment_fields = \\\\\\\\[\\\\\\\\]\\\\n\\\\nfor record in records:\\\\n    if 'ir\\\\\\\\.model\\\\\\\\.fields' not in record:\\\\n        continue\\\\n    \\\\n    model_match = re\\\\\\\\.search\\\\\\\\(r'<field name=\\\\\\\"model\\\\\\\">\\\\\\\\(\\\\\\\\[\\\\\\\\^<\\\\\\\\]\\\\\\\\+\\\\\\\\)</field>', record\\\\\\\\)\\\\n    if not model_match:\\\\n        continue\\\\n    \\\\n    model = model_match\\\\\\\\.group\\\\\\\\(1\\\\\\\\)\\\\n    \\\\n    name_match = re\\\\\\\\.search\\\\\\\\(r'<field name=\\\\\\\"name\\\\\\\">\\\\\\\\(\\\\\\\\[\\\\\\\\^<\\\\\\\\]\\\\\\\\+\\\\\\\\)</field>', record\\\\\\\\)\\\\n    desc_match = re\\\\\\\\.search\\\\\\\\(r'<field name=\\\\\\\"field_description\\\\\\\">\\\\\\\\(\\\\\\\\[\\\\\\\\^<\\\\\\\\]\\\\\\\\+\\\\\\\\)</field>', record\\\\\\\\)\\\\n    ttype_match = re\\\\\\\\.search\\\\\\\\(r'<field name=\\\\\\\"ttype\\\\\\\">\\\\\\\\(\\\\\\\\[\\\\\\\\^<\\\\\\\\]\\\\\\\\+\\\\\\\\)</field>', record\\\\\\\\)\\\\n    related_match = re\\\\\\\\.search\\\\\\\\(r'<field name=\\\\\\\"related\\\\\\\">\\\\\\\\(\\\\\\\\[\\\\\\\\^<\\\\\\\\]\\\\\\\\+\\\\\\\\)</field>', record\\\\\\\\)\\\\n    store_match = re\\\\\\\\.search\\\\\\\\(r'<field name=\\\\\\\"store\\\\\\\"\\\\\\\\[\\\\\\\\^>\\\\\\\\]\\\\\\\\*>\\\\\\\\(\\\\\\\\[\\\\\\\\^<\\\\\\\\]\\\\\\\\*\\\\\\\\)</field>', record\\\\\\\\)\\\\n    readonly_match = re\\\\\\\\.search\\\\\\\\(r'<field name=\\\\\\\"readonly\\\\\\\"\\\\\\\\[\\\\\\\\^>\\\\\\\\]\\\\\\\\*>\\\\\\\\(\\\\\\\\[\\\\\\\\^<\\\\\\\\]\\\\\\\\*\\\\\\\\)</field>', record\\\\\\\\)\\\\n    tracking_match = re\\\\\\\\.search\\\\\\\\(r'<field name=\\\\\\\"tracking\\\\\\\"\\\\\\\\[\\\\\\\\^>\\\\\\\\]\\\\\\\\*>\\\\\\\\(\\\\\\\\[\\\\\\\\^<\\\\\\\\]\\\\\\\\*\\\\\\\\)</field>', record\\\\\\\\)\\\\n    relation_match = re\\\\\\\\.search\\\\\\\\(r'<field name=\\\\\\\"relation\\\\\\\">\\\\\\\\(\\\\\\\\[\\\\\\\\^<\\\\\\\\]\\\\\\\\+\\\\\\\\)</field>', record\\\\\\\\)\\\\n    on_delete_match = re\\\\\\\\.search\\\\\\\\(r'<field name=\\\\\\\"on_delete\\\\\\\">\\\\\\\\(\\\\\\\\[\\\\\\\\^<\\\\\\\\]\\\\\\\\+\\\\\\\\)</field>', record\\\\\\\\)\\\\n    selection_match = re\\\\\\\\.search\\\\\\\\(r'<field name=\\\\\\\"selection\\\\\\\">\\\\\\\\(\\\\\\\\[\\\\\\\\^<\\\\\\\\]\\\\\\\\+\\\\\\\\)</field>', record\\\\\\\\)\\\\n    \\\\n    field_info = \\\\\\\\{\\\\n        'name': name_match\\\\\\\\.group\\\\\\\\(1\\\\\\\\) if name_match else '',\\\\n        'description': desc_match\\\\\\\\.group\\\\\\\\(1\\\\\\\\) if desc_match else '',\\\\n        'ttype': ttype_match\\\\\\\\.group\\\\\\\\(1\\\\\\\\) if ttype_match else '',\\\\n        'related': related_match\\\\\\\\.group\\\\\\\\(1\\\\\\\\) if related_match else '',\\\\n        'store': 'True' if store_match and 'True' in record\\\\\\\\[record\\\\\\\\.find\\\\\\\\('store'\\\\\\\\):record\\\\\\\\.find\\\\\\\\('store'\\\\\\\\)\\\\\\\\+50\\\\\\\\] else 'False',\\\\n        'readonly': 'True' if readonly_match and 'True' in record\\\\\\\\[record\\\\\\\\.find\\\\\\\\('readonly'\\\\\\\\):record\\\\\\\\.find\\\\\\\\('readonly'\\\\\\\\)\\\\\\\\+50\\\\\\\\] else 'False',\\\\n        'tracking': tracking_match\\\\\\\\.group\\\\\\\\(1\\\\\\\\) if tracking_match and tracking_match\\\\\\\\.group\\\\\\\\(1\\\\\\\\) not in \\\\\\\\['False', ''\\\\\\\\] else '',\\\\n        'relation': relation_match\\\\\\\\.group\\\\\\\\(1\\\\\\\\) if relation_match else '',\\\\n        'on_delete': on_delete_match\\\\\\\\.group\\\\\\\\(1\\\\\\\\) if on_delete_match else '',\\\\n        'selection': selection_match\\\\\\\\.group\\\\\\\\(1\\\\\\\\) if selection_match else '',\\\\n    \\\\\\\\}\\\\n    \\\\n    if model == 'sale\\\\\\\\.order':\\\\n        sale_order_fields\\\\\\\\.append\\\\\\\\(field_info\\\\\\\\)\\\\n    elif model == 'account\\\\\\\\.move':\\\\n        account_move_fields\\\\\\\\.append\\\\\\\\(field_info\\\\\\\\)\\\\n    elif model == 'account\\\\\\\\.payment':\\\\n        account_payment_fields\\\\\\\\.append\\\\\\\\(field_info\\\\\\\\)\\\\n\\\\nprint\\\\\\\\(\\\\\\\"=== SALE\\\\\\\\.ORDER FIELDS ===\\\\\\\"\\\\\\\\)\\\\nfor f in sale_order_fields:\\\\n    print\\\\\\\\(f\\\\\\\"  \\\\\\\\{f\\\\\\\\['name'\\\\\\\\]\\\\\\\\}: \\\\\\\\{f\\\\\\\\['ttype'\\\\\\\\]\\\\\\\\}, related=\\\\\\\\{f\\\\\\\\['related'\\\\\\\\]\\\\\\\\}, store=\\\\\\\\{f\\\\\\\\['store'\\\\\\\\]\\\\\\\\}, readonly=\\\\\\\\{f\\\\\\\\['readonly'\\\\\\\\]\\\\\\\\}, tracking=\\\\\\\\{f\\\\\\\\['tracking'\\\\\\\\]\\\\\\\\}, relation=\\\\\\\\{f\\\\\\\\['relation'\\\\\\\\]\\\\\\\\}, selection=\\\\\\\\{f\\\\\\\\['selection'\\\\\\\\]\\\\\\\\[:50\\\\\\\\] if f\\\\\\\\['selection'\\\\\\\\] else ''\\\\\\\\}\\\\\\\"\\\\\\\\)\\\\n\\\\nprint\\\\\\\\(\\\\\\\"\\\\\\\\\\\\\\\\n=== ACCOUNT\\\\\\\\.MOVE FIELDS ===\\\\\\\"\\\\\\\\)\\\\nfor f in account_move_fields:\\\\n    print\\\\\\\\(f\\\\\\\"  \\\\\\\\{f\\\\\\\\['name'\\\\\\\\]\\\\\\\\}: \\\\\\\\{f\\\\\\\\['ttype'\\\\\\\\]\\\\\\\\}, related=\\\\\\\\{f\\\\\\\\['related'\\\\\\\\]\\\\\\\\}, store=\\\\\\\\{f\\\\\\\\['store'\\\\\\\\]\\\\\\\\}, readonly=\\\\\\\\{f\\\\\\\\['readonly'\\\\\\\\]\\\\\\\\}, tracking=\\\\\\\\{f\\\\\\\\['tracking'\\\\\\\\]\\\\\\\\}\\\\\\\"\\\\\\\\)\\\\n\\\\nprint\\\\\\\\(\\\\\\\"\\\\\\\\\\\\\\\\n=== ACCOUNT\\\\\\\\.PAYMENT FIELDS ===\\\\\\\"\\\\\\\\)\\\\nfor f in account_payment_fields:\\\\n    print\\\\\\\\(f\\\\\\\"  \\\\\\\\{f\\\\\\\\['name'\\\\\\\\]\\\\\\\\}: \\\\\\\\{f\\\\\\\\['ttype'\\\\\\\\]\\\\\\\\}, related=\\\\\\\\{f\\\\\\\\['related'\\\\\\\\]\\\\\\\\}, store=\\\\\\\\{f\\\\\\\\['store'\\\\\\\\]\\\\\\\\}, readonly=\\\\\\\\{f\\\\\\\\['readonly'\\\\\\\\]\\\\\\\\}, tracking=\\\\\\\\{f\\\\\\\\['tracking'\\\\\\\\]\\\\\\\\}\\\\\\\"\\\\\\\\)\\\\nEOF$/\\\": {\\n            \\\"approve\\\": true,\\n            \\\"matchCommandLine\\\": true\\n        },\\n        \\\"uniq\\\": true,\\n        \\\"/^python3 /tmp/refactor_views\\\\\\\\.py 2>&1$/\\\": {\\n            \\\"approve\\\": true,\\n            \\\"matchCommandLine\\\": true\\n        },\\n        \\\"/^cat << 'PYTHONEOF' > /tmp/split_and_clean_views\\\\\\\\.py\\\\n#!/usr/bin/env python3\\\\nimport os\\\\nimport re\\\\nfrom collections import defaultdict\\\\n\\\\ndef extract_model\\\\\\\\(record_text\\\\\\\\):\\\\n    \\\\\\\"\\\\\\\"\\\\\\\"Extract model name from record XML text\\\\\\\"\\\\\\\"\\\\\\\"\\\\n    match = re\\\\\\\\.search\\\\\\\\(r'<field name=\\\\\\\"model\\\\\\\">\\\\\\\\(\\\\\\\\[\\\\\\\\^<\\\\\\\\]\\\\\\\\+\\\\\\\\)</field>', record_text\\\\\\\\)\\\\n    if match:\\\\n        return match\\\\\\\\.group\\\\\\\\(1\\\\\\\\)\\\\n    # Check for model eval=\\\\\\\"False\\\\\\\" \\\\\\\\(QWeb templates\\\\\\\\)\\\\n    if '<field name=\\\\\\\"model\\\\\\\" eval=\\\\\\\"False\\\\\\\"/>' in record_text or '<field name=\\\\\\\"model\\\\\\\" eval=\\\\\\\"False\\\\\\\" />' in record_text:\\\\n        return 'qweb'\\\\n    return None\\\\n\\\\ndef clean_record\\\\\\\\(record_text\\\\\\\\):\\\\n    \\\\\\\"\\\\\\\"\\\\\\\"Clean up a record - remove studio context and unnecessary fields\\\\\\\"\\\\\\\"\\\\\\\"\\\\n    # Remove context=\\\\\\\"\\\\\\\\{'studio': True\\\\\\\\}\\\\\\\"\\\\n    record_text = re\\\\\\\\.sub\\\\\\\\(r'\\\\\\\\\\\\\\\\s\\\\\\\\*context=\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\{\\\\\\\\\\\\\\\\'studio\\\\\\\\\\\\\\\\':\\\\\\\\\\\\\\\\s\\\\\\\\*True\\\\\\\\\\\\\\\\\\\\\\\\}\\\\\\\"', '', record_text\\\\\\\\)\\\\n    \\\\n    # Remove field_parent\\\\n    record_text = re\\\\\\\\.sub\\\\\\\\(r'\\\\\\\\\\\\\\\\s\\\\\\\\*<field name=\\\\\\\"field_parent\\\\\\\" eval=\\\\\\\"False\\\\\\\"/>\\\\\\\\\\\\\\\\n\\\\\\\\?', '', record_text\\\\\\\\)\\\\n    record_text = re\\\\\\\\.sub\\\\\\\\(r'\\\\\\\\\\\\\\\\s\\\\\\\\*<field name=\\\\\\\"field_parent\\\\\\\" eval=\\\\\\\"False\\\\\\\" />\\\\\\\\\\\\\\\\n\\\\\\\\?', '', record_text\\\\\\\\)\\\\n    \\\\n    # Remove key eval=\\\\\\\"False\\\\\\\"\\\\n    record_text = re\\\\\\\\.sub\\\\\\\\(r'\\\\\\\\\\\\\\\\s\\\\\\\\*<field name=\\\\\\\"key\\\\\\\" eval=\\\\\\\"False\\\\\\\"/>\\\\\\\\\\\\\\\\n\\\\\\\\?', '', record_text\\\\\\\\)\\\\n    record_text = re\\\\\\\\.sub\\\\\\\\(r'\\\\\\\\\\\\\\\\s\\\\\\\\*<field name=\\\\\\\"key\\\\\\\" eval=\\\\\\\"False\\\\\\\" />\\\\\\\\\\\\\\\\n\\\\\\\\?', '', record_text\\\\\\\\)\\\\n    \\\\n    # Remove empty groups_id\\\\n    record_text = re\\\\\\\\.sub\\\\\\\\(r'\\\\\\\\\\\\\\\\s\\\\\\\\*<field name=\\\\\\\"groups_id\\\\\\\" eval=\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\[\\\\\\\\\\\\\\\\\\\\\\\\(6, 0, \\\\\\\\\\\\\\\\\\\\\\\\[\\\\\\\\\\\\\\\\\\\\\\\\]\\\\\\\\\\\\\\\\\\\\\\\\)\\\\\\\\\\\\\\\\\\\\\\\\]\\\\\\\"/>\\\\\\\\\\\\\\\\n\\\\\\\\?', '', record_text\\\\\\\\)\\\\n    record_text = re\\\\\\\\.sub\\\\\\\\(r'\\\\\\\\\\\\\\\\s\\\\\\\\*<field name=\\\\\\\"groups_id\\\\\\\" eval=\\\\\\\"\\\\\\\\\\\\\\\\\\\\\\\\[\\\\\\\\\\\\\\\\\\\\\\\\(6, 0, \\\\\\\\\\\\\\\\\\\\\\\\[\\\\\\\\\\\\\\\\\\\\\\\\]\\\\\\\\\\\\\\\\\\\\\\\\)\\\\\\\\\\\\\\\\\\\\\\\\]\\\\\\\" />\\\\\\\\\\\\\\\\n\\\\\\\\?', '', record_text\\\\\\\\)\\\\n    \\\\n    # Remove inherit_id eval=\\\\\\\"False\\\\\\\"\\\\n    record_text = re\\\\\\\\.sub\\\\\\\\(r'\\\\\\\\\\\\\\\\s\\\\\\\\*<field name=\\\\\\\"inherit_id\\\\\\\" eval=\\\\\\\"False\\\\\\\"/>\\\\\\\\\\\\\\\\n\\\\\\\\?', '', record_text\\\\\\\\)\\\\n    record_text = re\\\\\\\\.sub\\\\\\\\(r'\\\\\\\\\\\\\\\\s\\\\\\\\*<field name=\\\\\\\"inherit_id\\\\\\\" eval=\\\\\\\"False\\\\\\\" />\\\\\\\\\\\\\\\\n\\\\\\\\?', '', record_text\\\\\\\\)\\\\n    \\\\n    # Remove mode=\\\\\\\"primary\\\\\\\" \\\\\\\\(it's the default\\\\\\\\)\\\\n    record_text = re\\\\\\\\.sub\\\\\\\\(r'\\\\\\\\\\\\\\\\s\\\\\\\\*<field name=\\\\\\\"mode\\\\\\\">primary</field>\\\\\\\\\\\\\\\\n\\\\\\\\?', '', record_text\\\\\\\\)\\\\n    \\\\n    # Remove active eval=\\\\\\\"True\\\\\\\"\\\\n    record_text = re\\\\\\\\.sub\\\\\\\\(r'\\\\\\\\\\\\\\\\s\\\\\\\\*<field name=\\\\\\\"active\\\\\\\" eval=\\\\\\\"True\\\\\\\"/>\\\\\\\\\\\\\\\\n\\\\\\\\?', '', record_text\\\\\\\\)\\\\n    record_text = re\\\\\\\\.sub\\\\\\\\(r'\\\\\\\\\\\\\\\\s\\\\\\\\*<field name=\\\\\\\"active\\\\\\\" eval=\\\\\\\"True\\\\\\\" />\\\\\\\\\\\\\\\\n\\\\\\\\?', '', record_text\\\\\\\\)\\\\n    \\\\n    return record_text\\\\n\\\\ndef get_file_category\\\\\\\\(model\\\\\\\\):\\\\n    \\\\\\\"\\\\\\\"\\\\\\\"Determine which file a model's views should go to\\\\\\\"\\\\\\\"\\\\\\\"\\\\n    if not model:\\\\n        return 'qweb'\\\\n    \\\\n    model_mapping = \\\\\\\\{\\\\n        # Standard models\\\\n        'account\\\\\\\\.move': 'account',\\\\n        'account\\\\\\\\.payment': 'account', \\\\n        'account\\\\\\\\.tax\\\\\\\\.group': 'account',\\\\n        'approval\\\\\\\\.request': 'approval',\\\\n        'base\\\\\\\\.automation': 'automation',\\\\n        'ir\\\\\\\\.actions\\\\\\\\.server': 'automation',\\\\n        'crm\\\\\\\\.lead': 'crm',\\\\n        'crm\\\\\\\\.stage': 'crm',\\\\n        'crm\\\\\\\\.lost\\\\\\\\.reason': 'crm',\\\\n        'helpdesk\\\\\\\\.ticket': 'helpdesk',\\\\n        'hr\\\\\\\\.contract': 'hr',\\\\n        'hr\\\\\\\\.employee': 'hr',\\\\n        'hr\\\\\\\\.payslip': 'hr',\\\\n        'hr\\\\\\\\.payslip\\\\\\\\.line': 'hr',\\\\n        'hr\\\\\\\\.salary\\\\\\\\.rule': 'hr',\\\\n        'hr\\\\\\\\.leave\\\\\\\\.type': 'hr',\\\\n        'product\\\\\\\\.template': 'product',\\\\n        'product\\\\\\\\.category': 'product',\\\\n        'project\\\\\\\\.project': 'project',\\\\n        'project\\\\\\\\.task': 'project',\\\\n        'project\\\\\\\\.task\\\\\\\\.type': 'project',\\\\n        'purchase\\\\\\\\.order': 'purchase',\\\\n        'res\\\\\\\\.company': 'res',\\\\n        'res\\\\\\\\.country': 'res',\\\\n        'res\\\\\\\\.country\\\\\\\\.state': 'res',\\\\n        'res\\\\\\\\.partner': 'res',\\\\n        'res\\\\\\\\.partner\\\\\\\\.bank': 'res',\\\\n        'res\\\\\\\\.users': 'res',\\\\n        'sale\\\\\\\\.order': 'sale',\\\\n        'sale\\\\\\\\.order\\\\\\\\.log': 'sale',\\\\n        'sale\\\\\\\\.subscription\\\\\\\\.report': 'sale',\\\\n        'stock\\\\\\\\.picking': 'stock',\\\\n        'stock\\\\\\\\.landed\\\\\\\\.cost': 'stock',\\\\n        'survey\\\\\\\\.user_input': 'survey',\\\\n        'utm\\\\\\\\.source': 'utm',\\\\n        'qweb': 'qweb',\\\\n    \\\\\\\\}\\\\n    \\\\n    if model in model_mapping:\\\\n        return model_mapping\\\\\\\\[model\\\\\\\\]\\\\n    \\\\n    # Custom x_ models\\\\n    if model\\\\\\\\.startswith\\\\\\\\('x_'\\\\\\\\):\\\\n        if 'lost' in model or 'other_lost' in model:\\\\n            return 'x_lost'\\\\n        elif 'delayed' in model or 'other_delayed' in model:\\\\n            return 'x_delayed'\\\\n        else:\\\\n            return 'x_studio'\\\\n    \\\\n    return 'other'\\\\n\\\\n# Read source file\\\\nsource_path = '/opt/odoo16/projects/studio_customization/data/ir_ui_view\\\\\\\\.xml'\\\\nwith open\\\\\\\\(source_path, 'r', encoding='utf-8'\\\\\\\\) as f:\\\\n    content = f\\\\\\\\.read\\\\\\\\(\\\\\\\\)\\\\n\\\\n# Extract all records using regex\\\\nrecord_pattern = re\\\\\\\\.compile\\\\\\\\(r'\\\\\\\\(<record\\\\\\\\[\\\\\\\\^>\\\\\\\\]\\\\\\\\*model=\\\\\\\"ir\\\\\\\\\\\\\\\\\\\\\\\\.ui\\\\\\\\\\\\\\\\\\\\\\\\.view\\\\\\\"\\\\\\\\[\\\\\\\\^>\\\\\\\\]\\\\\\\\*>\\\\\\\\.\\\\\\\\*\\\\\\\\?</record>\\\\\\\\)', re\\\\\\\\.DOTALL\\\\\\\\)\\\\nrecords = record_pattern\\\\\\\\.findall\\\\\\\\(content\\\\\\\\)\\\\n\\\\nprint\\\\\\\\(f\\\\\\\"Found \\\\\\\\{len\\\\\\\\(records\\\\\\\\)\\\\\\\\} records\\\\\\\"\\\\\\\\)\\\\n\\\\n# Group records by category\\\\ncategories = defaultdict\\\\\\\\(list\\\\\\\\)\\\\nfor record in records:\\\\n    model = extract_model\\\\\\\\(record\\\\\\\\)\\\\n    category = get_file_category\\\\\\\\(model\\\\\\\\)\\\\n    cleaned = clean_record\\\\\\\\(record\\\\\\\\)\\\\n    categories\\\\\\\\[category\\\\\\\\]\\\\\\\\.append\\\\\\\\(cleaned\\\\\\\\)\\\\n\\\\n# Write output files\\\\noutput_dir = '/opt/odoo16/projects/psae-venus/psae_venus_general_enhancement/views'\\\\nfor category, records_list in sorted\\\\\\\\(categories\\\\\\\\.items\\\\\\\\(\\\\\\\\)\\\\\\\\):\\\\n    output_path = os\\\\\\\\.path\\\\\\\\.join\\\\\\\\(output_dir, f'views_\\\\\\\\{category\\\\\\\\}\\\\\\\\.xml'\\\\\\\\)\\\\n    with open\\\\\\\\(output_path, 'w', encoding='utf-8'\\\\\\\\) as f:\\\\n        f\\\\\\\\.write\\\\\\\\('<\\\\\\\\?xml version=\\\\\\\"1\\\\\\\\.0\\\\\\\" encoding=\\\\\\\"utf-8\\\\\\\"\\\\\\\\?>\\\\\\\\\\\\\\\\n'\\\\\\\\)\\\\n        f\\\\\\\\.write\\\\\\\\('<odoo>\\\\\\\\\\\\\\\\n'\\\\\\\\)\\\\n        for record in records_list:\\\\n            f\\\\\\\\.write\\\\\\\\('  ' \\\\\\\\+ record\\\\\\\\.strip\\\\\\\\(\\\\\\\\) \\\\\\\\+ '\\\\\\\\\\\\\\\\n'\\\\\\\\)\\\\n        f\\\\\\\\.write\\\\\\\\('</odoo>\\\\\\\\\\\\\\\\n'\\\\\\\\)\\\\n    print\\\\\\\\(f\\\\\\\"Created views_\\\\\\\\{category\\\\\\\\}\\\\\\\\.xml with \\\\\\\\{len\\\\\\\\(records_list\\\\\\\\)\\\\\\\\} records\\\\\\\"\\\\\\\\)\\\\n\\\\nprint\\\\\\\\(\\\\\\\"\\\\\\\\\\\\\\\\n=== DONE ===\\\\\\\"\\\\\\\\)\\\\nPYTHONEOF\\\\npython3 /tmp/split_and_clean_views\\\\\\\\.py$/\\\": {\\n            \\\"approve\\\": true,\\n            \\\"matchCommandLine\\\": true\\n        },\\n        \\\"/^python3 /tmp/split_and_clean_views\\\\\\\\.py 2>&1$/\\\": {\\n            \\\"approve\\\": true,\\n            \\\"matchCommandLine\\\": true\\n        },\\n        \\\"/^cat << 'PYTHONEOF' > /tmp/format_qweb\\\\\\\\.py\\\\n#!/usr/bin/env python3\\\\nimport os\\\\nimport re\\\\n\\\\ndef format_qweb_file\\\\\\\\(source_path, target_path\\\\\\\\):\\\\n    \\\\\\\"\\\\\\\"\\\\\\\"Format QWeb template view files\\\\\\\"\\\\\\\"\\\\\\\"\\\\n    \\\\n    with open\\\\\\\\(source_path, 'r', encoding='utf-8'\\\\\\\\) as f:\\\\n        source_content = f\\\\\\\\.read\\\\\\\\(\\\\\\\\)\\\\n    \\\\n    # Extract records with model eval=\\\\\\\"False\\\\\\\" \\\\\\\\(QWeb templates\\\\\\\\)\\\\n    record_pattern = re\\\\\\\\.compile\\\\\\\\(r'<record\\\\\\\\[\\\\\\\\^>\\\\\\\\]\\\\\\\\*id=\\\\\\\"\\\\\\\\(\\\\\\\\[\\\\\\\\^\\\\\\\"\\\\\\\\]\\\\\\\\+\\\\\\\\)\\\\\\\"\\\\\\\\[\\\\\\\\^>\\\\\\\\]\\\\\\\\*model=\\\\\\\"ir\\\\\\\\\\\\\\\\\\\\\\\\.ui\\\\\\\\\\\\\\\\\\\\\\\\.view\\\\\\\"\\\\\\\\[\\\\\\\\^>\\\\\\\\]\\\\\\\\*>\\\\\\\\(\\\\\\\\.\\\\\\\\*\\\\\\\\?\\\\\\\\)</record>', re\\\\\\\\.DOTALL\\\\\\\\)\\\\n    \\\\n    records = \\\\\\\\[\\\\\\\\]\\\\n    for match in record_pattern\\\\\\\\.finditer\\\\\\\\(source_content\\\\\\\\):\\\\n        record_id = match\\\\\\\\.group\\\\\\\\(1\\\\\\\\)\\\\n        record_content = match\\\\\\\\.group\\\\\\\\(0\\\\\\\\)\\\\n        \\\\n        # Check for QWeb \\\\\\\\(model eval=\\\\\\\"False\\\\\\\"\\\\\\\\)\\\\n        if '<field name=\\\\\\\"model\\\\\\\" eval=\\\\\\\"False\\\\\\\"/>' in record_content or '<field name=\\\\\\\"model\\\\\\\" eval=\\\\\\\"False\\\\\\\" />' in record_content:\\\\n            records\\\\\\\\.append\\\\\\\\(\\\\\\\\(record_id, record_content\\\\\\\\)\\\\\\\\)\\\\n    \\\\n    if not records:\\\\n        print\\\\\\\\(\\\\\\\"No QWeb records found\\\\\\\"\\\\\\\\)\\\\n        return\\\\n    \\\\n    output = \\\\\\\\['<\\\\\\\\?xml version=\\\\\\\"1\\\\\\\\.0\\\\\\\" encoding=\\\\\\\"utf-8\\\\\\\"\\\\\\\\?>', '<odoo>', ''\\\\\\\\]\\\\n    \\\\n    for record_id, record_content in records:\\\\n        # Extract fields\\\\n        name_match = re\\\\\\\\.search\\\\\\\\(r'<field name=\\\\\\\"name\\\\\\\">\\\\\\\\(\\\\\\\\[\\\\\\\\^<\\\\\\\\]\\\\\\\\+\\\\\\\\)</field>', record_content\\\\\\\\)\\\\n        key_match = re\\\\\\\\.search\\\\\\\\(r'<field name=\\\\\\\"key\\\\\\\">\\\\\\\\(\\\\\\\\[\\\\\\\\^<\\\\\\\\]\\\\\\\\+\\\\\\\\)</field>', record_content\\\\\\\\)\\\\n        inherit_match = re\\\\\\\\.search\\\\\\\\(r'<field name=\\\\\\\"inherit_id\\\\\\\" ref=\\\\\\\"\\\\\\\\(\\\\\\\\[\\\\\\\\^\\\\\\\"\\\\\\\\]\\\\\\\\+\\\\\\\\)\\\\\\\"/>', record_content\\\\\\\\)\\\\n        priority_match = re\\\\\\\\.search\\\\\\\\(r'<field name=\\\\\\\"priority\\\\\\\">\\\\\\\\(\\\\\\\\[\\\\\\\\^<\\\\\\\\]\\\\\\\\+\\\\\\\\)</field>', record_content\\\\\\\\)\\\\n        arch_match = re\\\\\\\\.search\\\\\\\\(r'<field name=\\\\\\\"arch\\\\\\\" type=\\\\\\\"xml\\\\\\\">\\\\\\\\(\\\\\\\\.\\\\\\\\*\\\\\\\\?\\\\\\\\)</field>', record_content, re\\\\\\\\.DOTALL\\\\\\\\)\\\\n        \\\\n        name = name_match\\\\\\\\.group\\\\\\\\(1\\\\\\\\) if name_match else record_id\\\\n        key = key_match\\\\\\\\.group\\\\\\\\(1\\\\\\\\) if key_match else None\\\\n        priority = priority_match\\\\\\\\.group\\\\\\\\(1\\\\\\\\) if priority_match else \\\\\\\"16\\\\\\\"\\\\n        arch_content = arch_match\\\\\\\\.group\\\\\\\\(1\\\\\\\\)\\\\\\\\.strip\\\\\\\\(\\\\\\\\) if arch_match else \\\\\\\"\\\\\\\"\\\\n        \\\\n        # Clean up arch content\\\\n        arch_content = arch_content\\\\\\\\.replace\\\\\\\\('&quot;', \\\\\\\"'\\\\\\\"\\\\\\\\)\\\\n        arch_content = arch_content\\\\\\\\.replace\\\\\\\\('&amp;', '&'\\\\\\\\)\\\\n        \\\\n        # Indent arch content\\\\n        arch_lines = arch_content\\\\\\\\.split\\\\\\\\('\\\\\\\\\\\\\\\\n'\\\\\\\\)\\\\n        indented_arch = \\\\\\\\[\\\\\\\\]\\\\n        for line in arch_lines:\\\\n            stripped = line\\\\\\\\.strip\\\\\\\\(\\\\\\\\)\\\\n            if stripped:\\\\n                indented_arch\\\\\\\\.append\\\\\\\\('            ' \\\\\\\\+ stripped\\\\\\\\)\\\\n        arch_formatted = '\\\\\\\\\\\\\\\\n'\\\\\\\\.join\\\\\\\\(indented_arch\\\\\\\\)\\\\n        \\\\n        # Build record\\\\n        output\\\\\\\\.append\\\\\\\\(f'    <!-- \\\\\\\\{name\\\\\\\\} -->'\\\\\\\\)\\\\n        output\\\\\\\\.append\\\\\\\\(f'    <record id=\\\\\\\"\\\\\\\\{record_id\\\\\\\\}\\\\\\\" model=\\\\\\\"ir\\\\\\\\.ui\\\\\\\\.view\\\\\\\">'\\\\\\\\)\\\\n        output\\\\\\\\.append\\\\\\\\(f'        <field name=\\\\\\\"name\\\\\\\">\\\\\\\\{name\\\\\\\\}</field>'\\\\\\\\)\\\\n        output\\\\\\\\.append\\\\\\\\(f'        <field name=\\\\\\\"type\\\\\\\">qweb</field>'\\\\\\\\)\\\\n        if key:\\\\n            output\\\\\\\\.append\\\\\\\\(f'        <field name=\\\\\\\"key\\\\\\\">\\\\\\\\{key\\\\\\\\}</field>'\\\\\\\\)\\\\n        if inherit_match:\\\\n            output\\\\\\\\.append\\\\\\\\(f'        <field name=\\\\\\\"inherit_id\\\\\\\" ref=\\\\\\\"\\\\\\\\{inherit_match\\\\\\\\.group\\\\\\\\(1\\\\\\\\)\\\\\\\\}\\\\\\\"/>'\\\\\\\\)\\\\n        output\\\\\\\\.append\\\\\\\\(f'        <field name=\\\\\\\"priority\\\\\\\">\\\\\\\\{priority\\\\\\\\}</field>'\\\\\\\\)\\\\n        output\\\\\\\\.append\\\\\\\\(f'        <field name=\\\\\\\"arch\\\\\\\" type=\\\\\\\"xml\\\\\\\">'\\\\\\\\)\\\\n        output\\\\\\\\.append\\\\\\\\(arch_formatted\\\\\\\\)\\\\n        output\\\\\\\\.append\\\\\\\\(f'        </field>'\\\\\\\\)\\\\n        output\\\\\\\\.append\\\\\\\\(f'    </record>'\\\\\\\\)\\\\n        output\\\\\\\\.append\\\\\\\\(''\\\\\\\\)\\\\n    \\\\n    output\\\\\\\\.append\\\\\\\\('</odoo>'\\\\\\\\)\\\\n    \\\\n    with open\\\\\\\\(target_path, 'w', encoding='utf-8'\\\\\\\\) as f:\\\\n        f\\\\\\\\.write\\\\\\\\('\\\\\\\\\\\\\\\\n'\\\\\\\\.join\\\\\\\\(output\\\\\\\\)\\\\\\\\)\\\\n    \\\\n    print\\\\\\\\(f\\\\\\\"Created \\\\\\\\{target_path\\\\\\\\} with \\\\\\\\{len\\\\\\\\(records\\\\\\\\)\\\\\\\\} records\\\\\\\"\\\\\\\\)\\\\n\\\\n# Process QWeb\\\\nviews_dir = '/opt/odoo16/projects/psae-venus/psae_venus_general_enhancement/views'\\\\ntarget = os\\\\\\\\.path\\\\\\\\.join\\\\\\\\(views_dir, 'views_qweb\\\\\\\\.xml'\\\\\\\\)\\\\nformat_qweb_file\\\\\\\\('/opt/odoo16/projects/studio_customization/data/ir_ui_view\\\\\\\\.xml', target\\\\\\\\)\\\\nprint\\\\\\\\(\\\\\\\"Done with QWeb!\\\\\\\"\\\\\\\\)\\\\nPYTHONEOF\\\\npython3 /tmp/format_qweb\\\\\\\\.py$/\\\": {\\n            \\\"approve\\\": true,\\n            \\\"matchCommandLine\\\": true\\n        },\\n        \\\"/^cat << 'PYTHONEOF' > /tmp/format_actions\\\\\\\\.py\\\\n#!/usr/bin/env python3\\\\nimport os\\\\nimport re\\\\n\\\\ndef format_actions_file\\\\\\\\(source_path, target_path\\\\\\\\):\\\\n    \\\\\\\"\\\\\\\"\\\\\\\"Format window actions file\\\\\\\"\\\\\\\"\\\\\\\"\\\\n    \\\\n    with open\\\\\\\\(source_path, 'r', encoding='utf-8'\\\\\\\\) as f:\\\\n        source_content = f\\\\\\\\.read\\\\\\\\(\\\\\\\\)\\\\n    \\\\n    # Extract records\\\\n    record_pattern = re\\\\\\\\.compile\\\\\\\\(r'<record\\\\\\\\[\\\\\\\\^>\\\\\\\\]\\\\\\\\*id=\\\\\\\"\\\\\\\\(\\\\\\\\[\\\\\\\\^\\\\\\\"\\\\\\\\]\\\\\\\\+\\\\\\\\)\\\\\\\"\\\\\\\\[\\\\\\\\^>\\\\\\\\]\\\\\\\\*model=\\\\\\\"ir\\\\\\\\\\\\\\\\\\\\\\\\.actions\\\\\\\\\\\\\\\\\\\\\\\\.act_window\\\\\\\"\\\\\\\\[\\\\\\\\^>\\\\\\\\]\\\\\\\\*>\\\\\\\\(\\\\\\\\.\\\\\\\\*\\\\\\\\?\\\\\\\\)</record>', re\\\\\\\\.DOTALL\\\\\\\\)\\\\n    \\\\n    records = \\\\\\\\[\\\\\\\\]\\\\n    for match in record_pattern\\\\\\\\.finditer\\\\\\\\(source_content\\\\\\\\):\\\\n        record_id = match\\\\\\\\.group\\\\\\\\(1\\\\\\\\)\\\\n        record_content = match\\\\\\\\.group\\\\\\\\(0\\\\\\\\)\\\\n        records\\\\\\\\.append\\\\\\\\(\\\\\\\\(record_id, record_content\\\\\\\\)\\\\\\\\)\\\\n    \\\\n    print\\\\\\\\(f\\\\\\\"Found \\\\\\\\{len\\\\\\\\(records\\\\\\\\)\\\\\\\\} window action records\\\\\\\"\\\\\\\\)\\\\n    \\\\n    output = \\\\\\\\['<\\\\\\\\?xml version=\\\\\\\"1\\\\\\\\.0\\\\\\\" encoding=\\\\\\\"utf-8\\\\\\\"\\\\\\\\?>', '<odoo>', ''\\\\\\\\]\\\\n    \\\\n    for record_id, record_content in records:\\\\n        # Extract fields\\\\n        name_match = re\\\\\\\\.search\\\\\\\\(r'<field name=\\\\\\\"name\\\\\\\">\\\\\\\\(\\\\\\\\[\\\\\\\\^<\\\\\\\\]\\\\\\\\+\\\\\\\\)</field>', record_content\\\\\\\\)\\\\n        res_model_match = re\\\\\\\\.search\\\\\\\\(r'<field name=\\\\\\\"res_model\\\\\\\">\\\\\\\\(\\\\\\\\[\\\\\\\\^<\\\\\\\\]\\\\\\\\+\\\\\\\\)</field>', record_content\\\\\\\\)\\\\n        view_mode_match = re\\\\\\\\.search\\\\\\\\(r'<field name=\\\\\\\"view_mode\\\\\\\">\\\\\\\\(\\\\\\\\[\\\\\\\\^<\\\\\\\\]\\\\\\\\+\\\\\\\\)</field>', record_content\\\\\\\\)\\\\n        domain_match = re\\\\\\\\.search\\\\\\\\(r'<field name=\\\\\\\"domain\\\\\\\">\\\\\\\\(\\\\\\\\[\\\\\\\\^<\\\\\\\\]\\\\\\\\*\\\\\\\\)</field>', record_content\\\\\\\\)\\\\n        context_match = re\\\\\\\\.search\\\\\\\\(r'<field name=\\\\\\\"context\\\\\\\">\\\\\\\\(\\\\\\\\[\\\\\\\\^<\\\\\\\\]\\\\\\\\*\\\\\\\\)</field>', record_content\\\\\\\\)\\\\n        view_id_match = re\\\\\\\\.search\\\\\\\\(r'<field name=\\\\\\\"view_id\\\\\\\" ref=\\\\\\\"\\\\\\\\(\\\\\\\\[\\\\\\\\^\\\\\\\"\\\\\\\\]\\\\\\\\+\\\\\\\\)\\\\\\\"/>', record_content\\\\\\\\)\\\\n        search_view_match = re\\\\\\\\.search\\\\\\\\(r'<field name=\\\\\\\"search_view_id\\\\\\\" ref=\\\\\\\"\\\\\\\\(\\\\\\\\[\\\\\\\\^\\\\\\\"\\\\\\\\]\\\\\\\\+\\\\\\\\)\\\\\\\"/>', record_content\\\\\\\\)\\\\n        help_match = re\\\\\\\\.search\\\\\\\\(r'<field name=\\\\\\\"help\\\\\\\"><!\\\\\\\\\\\\\\\\\\\\\\\\[CDATA\\\\\\\\\\\\\\\\\\\\\\\\[\\\\\\\\(\\\\\\\\.\\\\\\\\*\\\\\\\\?\\\\\\\\)\\\\\\\\\\\\\\\\\\\\\\\\]\\\\\\\\\\\\\\\\\\\\\\\\]></field>', record_content, re\\\\\\\\.DOTALL\\\\\\\\)\\\\n        limit_match = re\\\\\\\\.search\\\\\\\\(r'<field name=\\\\\\\"limit\\\\\\\">\\\\\\\\(\\\\\\\\[\\\\\\\\^<\\\\\\\\]\\\\\\\\+\\\\\\\\)</field>', record_content\\\\\\\\)\\\\n        \\\\n        name = name_match\\\\\\\\.group\\\\\\\\(1\\\\\\\\) if name_match else record_id\\\\n        res_model = res_model_match\\\\\\\\.group\\\\\\\\(1\\\\\\\\) if res_model_match else \\\\\\\"\\\\\\\"\\\\n        view_mode = view_mode_match\\\\\\\\.group\\\\\\\\(1\\\\\\\\) if view_mode_match else \\\\\\\"tree,form\\\\\\\"\\\\n        \\\\n        # Clean context\\\\n        context = context_match\\\\\\\\.group\\\\\\\\(1\\\\\\\\)\\\\\\\\.strip\\\\\\\\(\\\\\\\\) if context_match else \\\\\\\"\\\\\\\\{\\\\\\\\}\\\\\\\"\\\\n        context = context\\\\\\\\.replace\\\\\\\\('\\\\\\\\\\\\\\\\n', ' '\\\\\\\\)\\\\\\\\.replace\\\\\\\\('  ', ' '\\\\\\\\)\\\\n        \\\\n        # Clean domain\\\\n        domain = domain_match\\\\\\\\.group\\\\\\\\(1\\\\\\\\)\\\\\\\\.strip\\\\\\\\(\\\\\\\\) if domain_match else \\\\\\\"\\\\\\\\[\\\\\\\\]\\\\\\\"\\\\n        if domain == \\\\\\\"False\\\\\\\" or not domain:\\\\n            domain = \\\\\\\"\\\\\\\\[\\\\\\\\]\\\\\\\"\\\\n        \\\\n        # Build record\\\\n        output\\\\\\\\.append\\\\\\\\(f'    <!-- \\\\\\\\{name\\\\\\\\} -->'\\\\\\\\)\\\\n        output\\\\\\\\.append\\\\\\\\(f'    <record id=\\\\\\\"\\\\\\\\{record_id\\\\\\\\}\\\\\\\" model=\\\\\\\"ir\\\\\\\\.actions\\\\\\\\.act_window\\\\\\\">'\\\\\\\\)\\\\n        output\\\\\\\\.append\\\\\\\\(f'        <field name=\\\\\\\"name\\\\\\\">\\\\\\\\{name\\\\\\\\}</field>'\\\\\\\\)\\\\n        output\\\\\\\\.append\\\\\\\\(f'        <field name=\\\\\\\"res_model\\\\\\\">\\\\\\\\{res_model\\\\\\\\}</field>'\\\\\\\\)\\\\n        output\\\\\\\\.append\\\\\\\\(f'        <field name=\\\\\\\"view_mode\\\\\\\">\\\\\\\\{view_mode\\\\\\\\}</field>'\\\\\\\\)\\\\n        \\\\n        if domain and domain != \\\\\\\"\\\\\\\\[\\\\\\\\]\\\\\\\":\\\\n            output\\\\\\\\.append\\\\\\\\(f'        <field name=\\\\\\\"domain\\\\\\\">\\\\\\\\{domain\\\\\\\\}</field>'\\\\\\\\)\\\\n        \\\\n        if context and context != \\\\\\\"\\\\\\\\{\\\\\\\\}\\\\\\\":\\\\n            output\\\\\\\\.append\\\\\\\\(f'        <field name=\\\\\\\"context\\\\\\\">\\\\\\\\{context\\\\\\\\}</field>'\\\\\\\\)\\\\n        \\\\n        if view_id_match:\\\\n            output\\\\\\\\.append\\\\\\\\(f'        <field name=\\\\\\\"view_id\\\\\\\" ref=\\\\\\\"\\\\\\\\{view_id_match\\\\\\\\.group\\\\\\\\(1\\\\\\\\)\\\\\\\\}\\\\\\\"/>'\\\\\\\\)\\\\n        \\\\n        if search_view_match:\\\\n            output\\\\\\\\.append\\\\\\\\(f'        <field name=\\\\\\\"search_view_id\\\\\\\" ref=\\\\\\\"\\\\\\\\{search_view_match\\\\\\\\.group\\\\\\\\(1\\\\\\\\)\\\\\\\\}\\\\\\\"/>'\\\\\\\\)\\\\n        \\\\n        if limit_match and limit_match\\\\\\\\.group\\\\\\\\(1\\\\\\\\) != \\\\\\\"80\\\\\\\":\\\\n            output\\\\\\\\.append\\\\\\\\(f'        <field name=\\\\\\\"limit\\\\\\\">\\\\\\\\{limit_match\\\\\\\\.group\\\\\\\\(1\\\\\\\\)\\\\\\\\}</field>'\\\\\\\\)\\\\n        \\\\n        if help_match:\\\\n            help_text = help_match\\\\\\\\.group\\\\\\\\(1\\\\\\\\)\\\\\\\\.strip\\\\\\\\(\\\\\\\\)\\\\n            # Simplify help text\\\\n            help_text = re\\\\\\\\.sub\\\\\\\\(r'\\\\\\\\\\\\\\\\s\\\\\\\\+', ' ', help_text\\\\\\\\)\\\\n            output\\\\\\\\.append\\\\\\\\(f'        <field name=\\\\\\\"help\\\\\\\" type=\\\\\\\"html\\\\\\\">'\\\\\\\\)\\\\n            output\\\\\\\\.append\\\\\\\\(f'            \\\\\\\\{help_text\\\\\\\\}'\\\\\\\\)\\\\n            output\\\\\\\\.append\\\\\\\\(f'        </field>'\\\\\\\\)\\\\n        \\\\n        output\\\\\\\\.append\\\\\\\\(f'    </record>'\\\\\\\\)\\\\n        output\\\\\\\\.append\\\\\\\\(''\\\\\\\\)\\\\n    \\\\n    output\\\\\\\\.append\\\\\\\\('</odoo>'\\\\\\\\)\\\\n    \\\\n    with open\\\\\\\\(target_path, 'w', encoding='utf-8'\\\\\\\\) as f:\\\\n        f\\\\\\\\.write\\\\\\\\('\\\\\\\\\\\\\\\\n'\\\\\\\\.join\\\\\\\\(output\\\\\\\\)\\\\\\\\)\\\\n    \\\\n    print\\\\\\\\(f\\\\\\\"Created \\\\\\\\{target_path\\\\\\\\} with \\\\\\\\{len\\\\\\\\(records\\\\\\\\)\\\\\\\\} records\\\\\\\"\\\\\\\\)\\\\n\\\\n# Process window actions\\\\nsource = '/opt/odoo16/projects/studio_customization/data/ir_actions_act_window\\\\\\\\.xml'\\\\ntarget = '/opt/odoo16/projects/psae-venus/psae_venus_general_enhancement/data/actions_window\\\\\\\\.xml'\\\\nformat_actions_file\\\\\\\\(source, target\\\\\\\\)\\\\nprint\\\\\\\\(\\\\\\\"Done!\\\\\\\"\\\\\\\\)\\\\nPYTHONEOF\\\\npython3 /tmp/format_actions\\\\\\\\.py$/\\\": {\\n            \\\"approve\\\": true,\\n            \\\"matchCommandLine\\\": true\\n        },\\n        \\\"/^python3 /tmp/format_actions\\\\\\\\.py 2>&1$/\\\": {\\n            \\\"approve\\\": true,\\n            \\\"matchCommandLine\\\": true\\n        },\\n        \\\"/^cat << 'PYTHONEOF' > /tmp/format_action_views\\\\\\\\.py\\\\n#!/usr/bin/env python3\\\\nimport os\\\\nimport re\\\\n\\\\ndef format_action_views_file\\\\\\\\(source_path, target_path\\\\\\\\):\\\\n    \\\\\\\"\\\\\\\"\\\\\\\"Format action-view links file\\\\\\\"\\\\\\\"\\\\\\\"\\\\n    \\\\n    with open\\\\\\\\(source_path, 'r', encoding='utf-8'\\\\\\\\) as f:\\\\n        source_content = f\\\\\\\\.read\\\\\\\\(\\\\\\\\)\\\\n    \\\\n    # Extract records\\\\n    record_pattern = re\\\\\\\\.compile\\\\\\\\(r'<record\\\\\\\\[\\\\\\\\^>\\\\\\\\]\\\\\\\\*id=\\\\\\\"\\\\\\\\(\\\\\\\\[\\\\\\\\^\\\\\\\"\\\\\\\\]\\\\\\\\+\\\\\\\\)\\\\\\\"\\\\\\\\[\\\\\\\\^>\\\\\\\\]\\\\\\\\*model=\\\\\\\"ir\\\\\\\\\\\\\\\\\\\\\\\\.actions\\\\\\\\\\\\\\\\\\\\\\\\.act_window\\\\\\\\\\\\\\\\\\\\\\\\.view\\\\\\\"\\\\\\\\[\\\\\\\\^>\\\\\\\\]\\\\\\\\*>\\\\\\\\(\\\\\\\\.\\\\\\\\*\\\\\\\\?\\\\\\\\)</record>', re\\\\\\\\.DOTALL\\\\\\\\)\\\\n    \\\\n    records = \\\\\\\\[\\\\\\\\]\\\\n    for match in record_pattern\\\\\\\\.finditer\\\\\\\\(source_content\\\\\\\\):\\\\n        record_id = match\\\\\\\\.group\\\\\\\\(1\\\\\\\\)\\\\n        record_content = match\\\\\\\\.group\\\\\\\\(0\\\\\\\\)\\\\n        records\\\\\\\\.append\\\\\\\\(\\\\\\\\(record_id, record_content\\\\\\\\)\\\\\\\\)\\\\n    \\\\n    print\\\\\\\\(f\\\\\\\"Found \\\\\\\\{len\\\\\\\\(records\\\\\\\\)\\\\\\\\} action-view records\\\\\\\"\\\\\\\\)\\\\n    \\\\n    output = \\\\\\\\['<\\\\\\\\?xml version=\\\\\\\"1\\\\\\\\.0\\\\\\\" encoding=\\\\\\\"utf-8\\\\\\\"\\\\\\\\?>', '<odoo>', ''\\\\\\\\]\\\\n    \\\\n    for record_id, record_content in records:\\\\n        # Extract fields\\\\n        act_window_match = re\\\\\\\\.search\\\\\\\\(r'<field name=\\\\\\\"act_window_id\\\\\\\" ref=\\\\\\\"\\\\\\\\(\\\\\\\\[\\\\\\\\^\\\\\\\"\\\\\\\\]\\\\\\\\+\\\\\\\\)\\\\\\\"/>', record_content\\\\\\\\)\\\\n        view_id_match = re\\\\\\\\.search\\\\\\\\(r'<field name=\\\\\\\"view_id\\\\\\\" ref=\\\\\\\"\\\\\\\\(\\\\\\\\[\\\\\\\\^\\\\\\\"\\\\\\\\]\\\\\\\\+\\\\\\\\)\\\\\\\"/>', record_content\\\\\\\\)\\\\n        view_mode_match = re\\\\\\\\.search\\\\\\\\(r'<field name=\\\\\\\"view_mode\\\\\\\">\\\\\\\\(\\\\\\\\[\\\\\\\\^<\\\\\\\\]\\\\\\\\+\\\\\\\\)</field>', record_content\\\\\\\\)\\\\n        sequence_match = re\\\\\\\\.search\\\\\\\\(r'<field name=\\\\\\\"sequence\\\\\\\">\\\\\\\\(\\\\\\\\\\\\\\\\d\\\\\\\\+\\\\\\\\)</field>', record_content\\\\\\\\)\\\\n        \\\\n        act_window = act_window_match\\\\\\\\.group\\\\\\\\(1\\\\\\\\) if act_window_match else \\\\\\\"\\\\\\\"\\\\n        view_mode = view_mode_match\\\\\\\\.group\\\\\\\\(1\\\\\\\\) if view_mode_match else \\\\\\\"\\\\\\\"\\\\n        \\\\n        # Build record\\\\n        output\\\\\\\\.append\\\\\\\\(f'    <record id=\\\\\\\"\\\\\\\\{record_id\\\\\\\\}\\\\\\\" model=\\\\\\\"ir\\\\\\\\.actions\\\\\\\\.act_window\\\\\\\\.view\\\\\\\">'\\\\\\\\)\\\\n        output\\\\\\\\.append\\\\\\\\(f'        <field name=\\\\\\\"act_window_id\\\\\\\" ref=\\\\\\\"\\\\\\\\{act_window\\\\\\\\}\\\\\\\"/>'\\\\\\\\)\\\\n        if sequence_match:\\\\n            output\\\\\\\\.append\\\\\\\\(f'        <field name=\\\\\\\"sequence\\\\\\\">\\\\\\\\{sequence_match\\\\\\\\.group\\\\\\\\(1\\\\\\\\)\\\\\\\\}</field>'\\\\\\\\)\\\\n        output\\\\\\\\.append\\\\\\\\(f'        <field name=\\\\\\\"view_mode\\\\\\\">\\\\\\\\{view_mode\\\\\\\\}</field>'\\\\\\\\)\\\\n        if view_id_match:\\\\n            output\\\\\\\\.append\\\\\\\\(f'        <field name=\\\\\\\"view_id\\\\\\\" ref=\\\\\\\"\\\\\\\\{view_id_match\\\\\\\\.group\\\\\\\\(1\\\\\\\\)\\\\\\\\}\\\\\\\"/>'\\\\\\\\)\\\\n        output\\\\\\\\.append\\\\\\\\(f'    </record>'\\\\\\\\)\\\\n        output\\\\\\\\.append\\\\\\\\(''\\\\\\\\)\\\\n    \\\\n    output\\\\\\\\.append\\\\\\\\('</odoo>'\\\\\\\\)\\\\n    \\\\n    with open\\\\\\\\(target_path, 'w', encoding='utf-8'\\\\\\\\) as f:\\\\n        f\\\\\\\\.write\\\\\\\\('\\\\\\\\\\\\\\\\n'\\\\\\\\.join\\\\\\\\(output\\\\\\\\)\\\\\\\\)\\\\n    \\\\n    print\\\\\\\\(f\\\\\\\"Created \\\\\\\\{target_path\\\\\\\\} with \\\\\\\\{len\\\\\\\\(records\\\\\\\\)\\\\\\\\} records\\\\\\\"\\\\\\\\)\\\\n\\\\n# Process action-view links\\\\nsource = '/opt/odoo16/projects/studio_customization/data/ir_actions_act_window_view\\\\\\\\.xml'\\\\ntarget = '/opt/odoo16/projects/psae-venus/psae_venus_general_enhancement/data/actions_window_view\\\\\\\\.xml'\\\\nformat_action_views_file\\\\\\\\(source, target\\\\\\\\)\\\\nprint\\\\\\\\(\\\\\\\"Done!\\\\\\\"\\\\\\\\)\\\\nPYTHONEOF\\\\npython3 /tmp/format_action_views\\\\\\\\.py$/\\\": {\\n            \\\"approve\\\": true,\\n            \\\"matchCommandLine\\\": true\\n        },\\n        \\\"/^python3 /tmp/format_action_views\\\\\\\\.py 2>&1$/\\\": {\\n            \\\"approve\\\": true,\\n            \\\"matchCommandLine\\\": true\\n        },\\n        \\\"/^cat << 'PYTHONEOF' > /tmp/check_fields\\\\\\\\.py\\\\n#!/usr/bin/env python3\\\\nimport re\\\\nimport os\\\\n\\\\n# Parse Studio field definitions\\\\nstudio_fields = \\\\\\\\{\\\\\\\\}\\\\nwith open\\\\\\\\('/opt/odoo16/projects/studio_customization/data/ir_model_fields\\\\\\\\.xml', 'r'\\\\\\\\) as f:\\\\n    content = f\\\\\\\\.read\\\\\\\\(\\\\\\\\)\\\\n\\\\n# Extract each record\\\\nrecord_pattern = re\\\\\\\\.compile\\\\\\\\(r'<record\\\\\\\\[\\\\\\\\^>\\\\\\\\]\\\\\\\\*model=\\\\\\\"ir\\\\\\\\\\\\\\\\\\\\\\\\.model\\\\\\\\\\\\\\\\\\\\\\\\.fields\\\\\\\"\\\\\\\\[\\\\\\\\^>\\\\\\\\]\\\\\\\\*>\\\\\\\\(\\\\\\\\.\\\\\\\\*\\\\\\\\?\\\\\\\\)</record>', re\\\\\\\\.DOTALL\\\\\\\\)\\\\nfor match in record_pattern\\\\\\\\.finditer\\\\\\\\(content\\\\\\\\):\\\\n    record_content = match\\\\\\\\.group\\\\\\\\(1\\\\\\\\)\\\\n    \\\\n    model_match = re\\\\\\\\.search\\\\\\\\(r'<field name=\\\\\\\"model\\\\\\\">\\\\\\\\(\\\\\\\\[\\\\\\\\^<\\\\\\\\]\\\\\\\\+\\\\\\\\)</field>', record_content\\\\\\\\)\\\\n    name_match = re\\\\\\\\.search\\\\\\\\(r'<field name=\\\\\\\"name\\\\\\\">\\\\\\\\(\\\\\\\\[\\\\\\\\^<\\\\\\\\]\\\\\\\\+\\\\\\\\)</field>', record_content\\\\\\\\)\\\\n    ttype_match = re\\\\\\\\.search\\\\\\\\(r'<field name=\\\\\\\"ttype\\\\\\\">\\\\\\\\(\\\\\\\\[\\\\\\\\^<\\\\\\\\]\\\\\\\\+\\\\\\\\)</field>', record_content\\\\\\\\)\\\\n    relation_match = re\\\\\\\\.search\\\\\\\\(r'<field name=\\\\\\\"relation\\\\\\\">\\\\\\\\(\\\\\\\\[\\\\\\\\^<\\\\\\\\]\\\\\\\\+\\\\\\\\)</field>', record_content\\\\\\\\)\\\\n    selection_match = re\\\\\\\\.search\\\\\\\\(r'<field name=\\\\\\\"selection\\\\\\\">\\\\\\\\(\\\\\\\\[\\\\\\\\^<\\\\\\\\]\\\\\\\\+\\\\\\\\)</field>', record_content\\\\\\\\)\\\\n    \\\\n    if model_match and name_match and ttype_match:\\\\n        model = model_match\\\\\\\\.group\\\\\\\\(1\\\\\\\\)\\\\n        name = name_match\\\\\\\\.group\\\\\\\\(1\\\\\\\\)\\\\n        ttype = ttype_match\\\\\\\\.group\\\\\\\\(1\\\\\\\\)\\\\n        relation = relation_match\\\\\\\\.group\\\\\\\\(1\\\\\\\\) if relation_match else None\\\\n        selection = selection_match\\\\\\\\.group\\\\\\\\(1\\\\\\\\) if selection_match else None\\\\n        \\\\n        if model not in studio_fields:\\\\n            studio_fields\\\\\\\\[model\\\\\\\\] = \\\\\\\\{\\\\\\\\}\\\\n        studio_fields\\\\\\\\[model\\\\\\\\]\\\\\\\\[name\\\\\\\\] = \\\\\\\\{\\\\n            'ttype': ttype,\\\\n            'relation': relation,\\\\n            'selection': selection\\\\n        \\\\\\\\}\\\\n\\\\n# Map Odoo field types to Python fields\\\\ntype_map = \\\\\\\\{\\\\n    'char': 'Char',\\\\n    'text': 'Text',\\\\n    'html': 'Html',\\\\n    'integer': 'Integer',\\\\n    'float': 'Float',\\\\n    'monetary': 'Monetary',\\\\n    'boolean': 'Boolean',\\\\n    'date': 'Date',\\\\n    'datetime': 'Datetime',\\\\n    'binary': 'Binary',\\\\n    'selection': 'Selection',\\\\n    'many2one': 'Many2one',\\\\n    'one2many': 'One2many',\\\\n    'many2many': 'Many2many',\\\\n\\\\\\\\}\\\\n\\\\n# Check each model file\\\\nmodels_dir = '/opt/odoo16/projects/psae-venus/psae_venus_general_enhancement/models'\\\\nissues = \\\\\\\\[\\\\\\\\]\\\\n\\\\nfor filename in os\\\\\\\\.listdir\\\\\\\\(models_dir\\\\\\\\):\\\\n    if not filename\\\\\\\\.endswith\\\\\\\\('\\\\\\\\.py'\\\\\\\\) or filename == '__init__\\\\\\\\.py':\\\\n        continue\\\\n    \\\\n    filepath = os\\\\\\\\.path\\\\\\\\.join\\\\\\\\(models_dir, filename\\\\\\\\)\\\\n    with open\\\\\\\\(filepath, 'r'\\\\\\\\) as f:\\\\n        code = f\\\\\\\\.read\\\\\\\\(\\\\\\\\)\\\\n    \\\\n    # Find model inheritance\\\\n    inherit_match = re\\\\\\\\.search\\\\\\\\(r\\\\\\\"_inherit\\\\\\\\\\\\\\\\s\\\\\\\\*=\\\\\\\\\\\\\\\\s\\\\\\\\*\\\\\\\\['\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\]\\\\\\\\(\\\\\\\\[\\\\\\\\^'\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\]\\\\\\\\+\\\\\\\\)\\\\\\\\['\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\]\\\\\\\", code\\\\\\\\)\\\\n    name_match = re\\\\\\\\.search\\\\\\\\(r\\\\\\\"_name\\\\\\\\\\\\\\\\s\\\\\\\\*=\\\\\\\\\\\\\\\\s\\\\\\\\*\\\\\\\\['\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\]\\\\\\\\(\\\\\\\\[\\\\\\\\^'\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\]\\\\\\\\+\\\\\\\\)\\\\\\\\['\\\\\\\\\\\\\\\\\\\\\\\"\\\\\\\\]\\\\\\\", code\\\\\\\\)\\\\n    \\\\n    model_name = None\\\\n    if inherit_match:\\\\n        model_name = inherit_match\\\\\\\\.group\\\\\\\\(1\\\\\\\\)\\\\n    elif name_match:\\\\n        model_name = name_match\\\\\\\\.group\\\\\\\\(1\\\\\\\\)\\\\n    \\\\n    if not model_name:\\\\n        continue\\\\n    \\\\n    # Find all field definitions in code\\\\n    field_pattern = re\\\\\\\\.compile\\\\\\\\(r'\\\\\\\\(\\\\\\\\\\\\\\\\w\\\\\\\\+\\\\\\\\)\\\\\\\\\\\\\\\\s\\\\\\\\*=\\\\\\\\\\\\\\\\s\\\\\\\\*fields\\\\\\\\\\\\\\\\\\\\\\\\