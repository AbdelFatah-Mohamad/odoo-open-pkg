<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cheap daily probe: a dead token is found within a day, not when a sync
             fails at 2 AM. -->
        <record forcecreate="True" id="ir_cron_ads_token_health" model="ir.cron">
            <field name="name">Ads: Token Health Check</field>
            <field name="model_id" ref="model_ads_account"/>
            <field name="state">code</field>
            <field name="code">model._cron_token_health()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
        </record>

        <!-- Structure mirror: campaigns -> ad sets -> ads, idempotent upserts.
             Cheap no-op while no account is connected. -->
        <record forcecreate="True" id="ir_cron_ads_sync_structure" model="ir.cron">
            <field name="name">Ads: Sync Campaign Structure</field>
            <field name="model_id" ref="model_ads_sync_engine"/>
            <field name="state">code</field>
            <field name="code">model._cron_sync_structure()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
        </record>

        <!-- Daily rolling 28-day re-pull (Meta restates attribution) + backfill
             chaining. The cron re-triggers itself while backfill work remains. -->
        <record forcecreate="True" id="ir_cron_ads_sync_insights" model="ir.cron">
            <field name="name">Ads: Sync Insights (Daily)</field>
            <field name="model_id" ref="model_ads_sync_engine"/>
            <field name="state">code</field>
            <field name="code">model._cron_sync_insights()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
        </record>

        <record forcecreate="True" id="ir_cron_ads_sync_insights_today" model="ir.cron">
            <field name="name">Ads: Refresh Today's Insights</field>
            <field name="model_id" ref="model_ads_sync_engine"/>
            <field name="state">code</field>
            <field name="code">model._cron_sync_insights(today_only=True)</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">4</field>
            <field name="interval_type">hours</field>
        </record>

        <!-- Leads every 15 minutes: Google retention is treated as 30 days
             (conservative), Meta 90 — but real-time-ish arrival is the point. -->
        <record forcecreate="True" id="ir_cron_ads_sync_leads" model="ir.cron">
            <field name="name">Ads: Sync Leads</field>
            <field name="model_id" ref="model_ads_sync_engine"/>
            <field name="state">code</field>
            <field name="code">model._cron_sync_leads()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
        </record>

        <record forcecreate="True" id="ir_cron_ads_insight_compact" model="ir.cron">
            <field name="name">Ads: Compact Old Insight Rows</field>
            <field name="model_id" ref="model_ads_insight"/>
            <field name="state">code</field>
            <field name="code">model._cron_compact()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
        </record>

        <!-- Outbound mutation queue: commit-per-job, retries by failure type. -->
        <record forcecreate="True" id="ir_cron_ads_push_queue" model="ir.cron">
            <field name="name">Ads: Push Queued Changes</field>
            <field name="model_id" ref="model_ads_push_job"/>
            <field name="state">code</field>
            <field name="code">model._push_cron()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
        </record>

        <record forcecreate="True" id="ir_cron_ads_log_gc" model="ir.cron">
            <field name="name">Ads: Sync Log Cleanup</field>
            <field name="model_id" ref="model_ads_sync_log"/>
            <field name="state">code</field>
            <field name="code">model._gc_sync_logs()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
        </record>
    </data>
</odoo>
