<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ads_campaign_view_kanban" model="ir.ui.view">
        <field name="name">ads.campaign.kanban</field>
        <field name="model">ads.campaign</field>
        <field name="arch" type="xml">
            <kanban default_group_by="status" quick_create="false">
                <field name="provider"/>
                <field name="sync_status"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between">
                            <strong><field name="title"/></strong>
                            <span class="badge text-bg-info"><field name="provider"/></span>
                        </div>
                        <div class="text-muted"><field name="account_id"/></div>
                        <div class="d-flex justify-content-between mt-2">
                            <span title="Spend, last 30 days">
                                  <field name="spend_30d" widget="monetary"/>
                                  <field name="currency_id" invisible="1"/></span>
                            <span t-if="record.sync_status.raw_value == 'conflict'"
                                  class="badge text-bg-danger">Conflict</span>
                            <span t-if="record.sync_status.raw_value == 'push_error'"
                                  class="badge text-bg-danger">Push Error</span>
                            <span t-if="record.sync_status.raw_value == 'draft'"
                                  class="badge text-bg-warning">Draft</span>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="ads_campaign_view_list" model="ir.ui.view">
        <field name="name">ads.campaign.list</field>
        <field name="model">ads.campaign</field>
        <field name="arch" type="xml">
            <list string="Campaigns">
                <field name="title"/>
                <field name="account_id"/>
                <field name="provider" optional="show"/>
                <field name="objective" optional="show"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'enabled'"
                       decoration-warning="status == 'paused'"/>
                <field name="budget_type" optional="hide"/>
                <field name="budget_amount" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="sync_status" widget="badge" optional="show"
                       decoration-danger="sync_status in ('conflict', 'push_error')"
                       decoration-info="sync_status == 'draft'"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="ads_campaign_view_form" model="ir.ui.view">
        <field name="name">ads.campaign.form</field>
        <field name="model">ads.campaign</field>
        <field name="arch" type="xml">
            <form string="Campaign">
                <header>
                    <button name="action_push" type="object" string="Create on Platform"
                            class="btn-primary" invisible="sync_status != 'draft'"
                            confirm="The campaign will be created PAUSED on the ad platform. Continue?"
                            groups="ac_ads_connector.group_ads_admin"/>
                    <button name="action_pause" type="object" string="Pause"
                            invisible="status != 'enabled' or not external_id"
                            groups="ac_ads_connector.group_ads_admin"/>
                    <button name="action_activate" type="object" string="Activate"
                            invisible="status != 'paused' or not external_id"
                            confirm="This will set the campaign LIVE on the ad platform. Continue?"
                            groups="ac_ads_connector.group_ads_admin"/>
                    <button name="%(ac_ads_connector.action_ads_push_wizard)d" type="action"
                            string="Push Changes" class="btn-primary"
                            invisible="sync_status not in ('local_changes', 'push_error')"
                            groups="ac_ads_connector.group_ads_admin"/>
                    <button name="action_resolve_keep_local" type="object" string="Keep Local"
                            invisible="sync_status != 'conflict'"
                            groups="ac_ads_connector.group_ads_admin"/>
                    <button name="action_resolve_keep_remote" type="object" string="Keep Remote"
                            invisible="sync_status != 'conflict'"
                            groups="ac_ads_connector.group_ads_admin"/>
                    <button name="action_open_in_platform" type="object" string="Open in Ads Manager"/>
                    <field name="status" widget="statusbar"/>
                    <field name="sync_status" invisible="1"/>
                    <field name="external_id" invisible="1"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_adsets" type="object" class="oe_stat_button"
                                icon="fa-folder-open-o">
                            <field name="adset_count" widget="statinfo" string="Ad Sets"/>
                        </button>
                        <button name="action_view_ads" type="object" class="oe_stat_button"
                                icon="fa-bullhorn">
                            <field name="ad_count" widget="statinfo" string="Ads"/>
                        </button>
                        <button name="action_view_tracked_links" type="object"
                                class="oe_stat_button" icon="fa-link"
                                invisible="not tracked_click_count">
                            <field name="tracked_click_count" widget="statinfo"
                                   string="Tracked Clicks"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Conflict" bg_color="text-bg-danger"
                            invisible="sync_status != 'conflict'"/>
                    <div class="oe_title">
                        <h1><field name="title" placeholder="Campaign name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="account_id" readonly="external_id"/>
                            <field name="provider"/>
                            <field name="objective"/>
                            <field name="objective_raw" groups="base.group_no_one"/>
                            <field name="special_ad_categories"
                                   invisible="provider != 'meta'"
                                   groups="ac_ads_connector.group_ads_admin"/>
                            <field name="platform_status" invisible="not external_id"/>
                        </group>
                        <group>
                            <field name="budget_type"/>
                            <field name="budget_amount"
                                   invisible="budget_type == 'none'"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="bid_strategy"/>
                            <field name="start_datetime"/>
                            <field name="stop_datetime"/>
                        </group>
                    </group>
                    <group string="Performance (last 30 days)">
                        <group>
                            <field name="spend_30d"/>
                            <field name="impressions_30d"/>
                            <field name="clicks_30d"/>
                        </group>
                        <group>
                            <field name="insight_leads_30d"/>
                            <field name="cpl_30d"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Ad Sets" name="adsets">
                            <field name="adset_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="status"/>
                                    <field name="budget_amount"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="optimization_goal" optional="show"/>
                                </list>
                            </field>
                        </page>
                        <page string="Attribution" name="attribution">
                            <group>
                                <field name="utm_campaign_id" readonly="1"/>
                            </group>
                        </page>
                        <page string="Technical" name="technical" groups="base.group_no_one">
                            <group>
                                <field name="external_id"/>
                                <field name="sync_status"/>
                                <field name="google_budget_resource"/>
                                <field name="remote_updated_at"/>
                                <field name="last_synced_at"/>
                                <field name="sync_error"/>
                                <field name="push_error_message"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="ads_campaign_view_search" model="ir.ui.view">
        <field name="name">ads.campaign.search</field>
        <field name="model">ads.campaign</field>
        <field name="arch" type="xml">
            <search string="Campaigns">
                <field name="title"/>
                <field name="account_id"/>
                <filter string="Active" name="enabled" domain="[('status', '=', 'enabled')]"/>
                <filter string="Paused" name="paused" domain="[('status', '=', 'paused')]"/>
                <separator/>
                <filter string="Meta" name="meta" domain="[('provider', '=', 'meta')]"/>
                <filter string="Google" name="google" domain="[('provider', '=', 'google')]"/>
                <separator/>
                <filter string="Needs Attention" name="attention"
                        domain="[('sync_status', 'in', ('conflict', 'push_error'))]"/>
                <separator/>
                <filter string="Account" name="group_account" context="{'group_by': 'account_id'}"/>
                <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                <filter string="Objective" name="group_objective" context="{'group_by': 'objective'}"/>
            </search>
        </field>
    </record>

    <record id="action_ads_campaign" model="ir.actions.act_window">
        <field name="name">Campaigns</field>
        <field name="res_model">ads.campaign</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No campaigns yet</p>
            <p>Connect an ad account and click <b>Sync Structure</b> to mirror your
               campaigns here.</p>
        </field>
    </record>
</odoo>
