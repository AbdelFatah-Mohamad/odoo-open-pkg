<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ads_sync_log_view_list" model="ir.ui.view">
        <field name="name">ads.sync.log.list</field>
        <field name="model">ads.sync.log</field>
        <field name="arch" type="xml">
            <list string="Sync Runs" create="false" edit="false">
                <field name="started_at"/>
                <field name="account_id"/>
                <field name="job_type"/>
                <field name="trigger"/>
                <field name="records_created"/>
                <field name="records_updated"/>
                <field name="records_failed"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-warning="state == 'partial'"
                       decoration-danger="state == 'error'"/>
            </list>
        </field>
    </record>

    <record id="ads_sync_log_view_form" model="ir.ui.view">
        <field name="name">ads.sync.log.form</field>
        <field name="model">ads.sync.log</field>
        <field name="arch" type="xml">
            <form string="Sync Run" create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="account_id"/>
                            <field name="job_type"/>
                            <field name="trigger"/>
                            <field name="state"/>
                        </group>
                        <group>
                            <field name="started_at"/>
                            <field name="finished_at"/>
                            <field name="records_created"/>
                            <field name="records_updated"/>
                            <field name="records_skipped"/>
                            <field name="records_failed"/>
                            <field name="watermark_before"/>
                            <field name="watermark_after"/>
                            <field name="async_report_ref"/>
                        </group>
                    </group>
                    <group string="Log">
                        <field name="log" nolabel="1"/>
                    </group>
                    <group string="Error" invisible="not error">
                        <field name="error" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ads_sync_log" model="ir.actions.act_window">
        <field name="name">Sync Runs</field>
        <field name="res_model">ads.sync.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
