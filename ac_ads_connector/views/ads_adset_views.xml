<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ads_adset_view_list" model="ir.ui.view">
        <field name="name">ads.adset.list</field>
        <field name="model">ads.adset</field>
        <field name="arch" type="xml">
            <list string="Ad Sets">
                <field name="name"/>
                <field name="campaign_id"/>
                <field name="account_id" optional="show"/>
                <field name="provider" optional="hide"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'enabled'"
                       decoration-warning="status == 'paused'"/>
                <field name="budget_amount" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="optimization_goal" optional="show"/>
                <field name="adgroup_type" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="ads_adset_view_form" model="ir.ui.view">
        <field name="name">ads.adset.form</field>
        <field name="model">ads.adset</field>
        <field name="arch" type="xml">
            <form string="Ad Set">
                <header>
                    <button name="action_push" type="object" string="Create on Platform"
                            class="btn-primary" invisible="sync_status != 'draft'"
                            confirm="The ad set will be created PAUSED on the ad platform. Continue?"
                            groups="ac_ads_connector.group_ads_admin"/>
                    <button name="action_pause" type="object" string="Pause"
                            invisible="status != 'enabled' or not external_id"
                            groups="ac_ads_connector.group_ads_admin"/>
                    <button name="action_activate" type="object" string="Activate"
                            invisible="status != 'paused' or not external_id"
                            confirm="This will set the ad set LIVE on the ad platform. Continue?"
                            groups="ac_ads_connector.group_ads_admin"/>
                    <field name="sync_status" invisible="1"/>
                    <field name="external_id" invisible="1"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="campaign_id" readonly="external_id"/>
                            <field name="account_id"/>
                            <field name="type_name"/>
                            <field name="status"/>
                            <field name="platform_status" invisible="not external_id"/>
                            <field name="targeting" invisible="provider == 'google'"
                                   groups="ac_ads_connector.group_ads_admin"/>
                        </group>
                        <group>
                            <field name="budget_type"/>
                            <field name="budget_amount" invisible="budget_type == 'none'"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="optimization_goal" invisible="provider == 'google'"/>
                            <field name="billing_event" invisible="provider == 'google'"/>
                            <field name="adgroup_type" invisible="provider == 'meta'"/>
                            <field name="cpc_bid" invisible="provider == 'meta'"/>
                            <field name="provider" invisible="1"/>
                            <field name="start_datetime"/>
                            <field name="stop_datetime"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Ads" name="ads">
                            <field name="ad_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="status"/>
                                    <field name="google_ad_type" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Technical" name="technical" groups="base.group_no_one">
                            <group>
                                <field name="external_id"/>
                                <field name="sync_status"/>
                                <field name="targeting"/>
                                <field name="promoted_object"/>
                                <field name="last_synced_at"/>
                                <field name="sync_error"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ads_adset" model="ir.actions.act_window">
        <field name="name">Ad Sets</field>
        <field name="res_model">ads.adset</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
