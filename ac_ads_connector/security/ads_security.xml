<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="module_category_ads" model="ir.module.category">
            <field name="name">Ads Connector</field>
            <field name="sequence">21</field>
        </record>

        <record id="res_groups_privilege_ads" model="res.groups.privilege">
            <field name="name">Ads</field>
            <field name="category_id" ref="module_category_ads"/>
            <field name="sequence">10</field>
        </record>

        <record id="group_ads_user" model="res.groups">
            <field name="name">User</field>
            <field name="privilege_id" ref="res_groups_privilege_ads"/>
            <field name="comment">See campaigns, ad sets, ads, insights and process staged leads.</field>
        </record>

        <record id="group_ads_admin" model="res.groups">
            <field name="name">Administrator</field>
            <field name="implied_ids" eval="[Command.link(ref('group_ads_user'))]"/>
            <field name="privilege_id" ref="res_groups_privilege_ads"/>
            <field name="comment">Configure accounts and credentials, push changes to the platforms.</field>
            <field name="user_ids" eval="[Command.link(ref('base.user_admin'))]"/>
        </record>

        <record id="ads_account_company_rule" model="ir.rule">
            <field name="name">Ads Account multi-company</field>
            <field name="model_id" ref="model_ads_account"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
