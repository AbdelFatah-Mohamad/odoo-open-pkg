<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- View account.payment form -->
    <record id="view_account_payment_form" model="ir.ui.view">
        <field name="name">view.account.payment.form</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="odoo_check_managment.view_account_payment_form_inherit_check_management"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='multi_payments_ids']/list/field[@name='currency_id']" position="after">
                <field name="currency_rate" />
            </xpath>
        </field>
    </record>

</odoo>